diff --git a/framework/adapters/__init__.py b/framework/adapters/__init__.py
new file mode 100644
index 0000000..e69de29
diff --git a/framework/adapters/legacy_collector.py b/framework/adapters/legacy_collector.py
new file mode 100644
index 0000000..a466c19
--- /dev/null
+++ b/framework/adapters/legacy_collector.py
@@ -0,0 +1,24 @@
+"""把现有 src/ 组件适配成 framework/feature 端口（双轨桥接）。
+
+只做薄委托，不改旧组件行为；P1_SWITCH 打开后由 usecase 调用。
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+
+class LegacyCollectorAdapter:
+    """SnapshotCollector → SnapshotCollectorPort 薄壳。"""
+
+    def __init__(self, collector: Any) -> None:
+        self._inner = collector
+
+    async def resolve_market(self, slug: str) -> tuple[str, str] | None:
+        return await self._inner.resolve_market(slug)
+
+    async def backfill_prev_bucket(self, condition_id: str) -> None:
+        await self._inner.backfill_prev_bucket(condition_id)
+
+    async def fetch_live_prices(self, rows: list[Any]) -> Mapping[str, float]:
+        return await self._inner.fetch_live_prices(rows)
diff --git a/tests/test_legacy_adapter.py b/tests/test_legacy_adapter.py
new file mode 100644
index 0000000..f5a4573
--- /dev/null
+++ b/tests/test_legacy_adapter.py
@@ -0,0 +1,20 @@
+"""LegacyCollectorAdapter 桥接测试。"""
+
+import asyncio
+
+from framework.adapters.legacy_collector import LegacyCollectorAdapter
+
+
+class FakeCollector:
+    async def resolve_market(self, slug): return ("cid-x", slug)
+    async def backfill_prev_bucket(self, cid): self.cid = cid
+    async def fetch_live_prices(self, rows): return {"a": 1.0}
+
+
+def test_adapter_delegates():
+    c = FakeCollector()
+    a = LegacyCollectorAdapter(c)
+    assert asyncio.run(a.resolve_market("s")) == ("cid-x", "s")
+    asyncio.run(a.backfill_prev_bucket("x"))
+    assert c.cid == "x"
+    assert asyncio.run(a.fetch_live_prices([])) == {"a": 1.0}
