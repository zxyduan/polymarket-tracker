--- /dev/null
+++ b/framework/delivery/ntfy_channel.py
@@ -0,0 +1,64 @@
+"""ntfy 通道（设计 v3.5 §7.4，按 10 §4.7 平移）。
+
+POST {server}/{topic} 纯文本；失败抛异常由 router 捕获为 channel 级失败；
+成功才落痕（保持 09 §3.6.1 不对称现状，不压平）。
+"""
+
+from __future__ import annotations
+
+import logging
+
+import httpx
+
+from framework.delivery.router import DeliveryResult
+from framework.delivery.targets import DeliveryTarget
+from framework.models.message import RenderedMessage
+
+logger = logging.getLogger(__name__)
+
+
+class NtfyChannel:
+    name = "ntfy"
+
+    def __init__(
+        self,
+        server: str,
+        *,
+        access_token: str = "",
+        title_prefix: str = "",
+        priority: str = "",
+        tags: str = "",
+        storage=None,
+        timeout: float = 15.0,
+    ) -> None:
+        self._server = server.rstrip("/")
+        headers: dict[str, str] = {"Content-Type": "text/plain"}
+        if access_token:
+            headers["Authorization"] = f"Bearer {access_token}"
+        if title_prefix:
+            headers["X-Title"] = title_prefix
+        if priority:
+            headers["X-Priority"] = str(priority)
+        if tags:
+            headers["X-Tags"] = ",".join(t.strip() for t in tags.split(",") if t.strip())
+        self._headers = headers
+        self._storage = storage
+        self._timeout = timeout
+
+    def describe(self) -> str:
+        return f"ntfy@{self._server}"
+
+    async def deliver(
+        self, msg: RenderedMessage, targets: list[DeliveryTarget]
+    ) -> DeliveryResult:
+        keys = ",".join(msg.event_keys)
+        async with httpx.AsyncClient(
+            timeout=httpx.Timeout(connect=10, read=self._timeout, write=20, pool=10)
+        ) as client:
+            for t in targets:
+                url = f"{self._server}/{t.address.strip('/')}"
+                resp = await client.post(url, content=msg.body, headers=self._headers)
+                resp.raise_for_status()
+                if self._storage is not None:
+                    await self._storage.record_notification(url, msg.body, keys, "success")
+        return DeliveryResult(outcomes=())
diff --git a/framework/delivery/telegram_channel.py b/framework/delivery/telegram_channel.py
new file mode 100644
index 0000000..9c44acd
--- /dev/null
+++ b/framework/delivery/telegram_channel.py
@@ -0,0 +1,49 @@
+"""Telegram 通道（设计 v3.5 §7.4，按 10 §4.7 平移）。
+
+逐 chat 投递：target 级失败只落痕、不抛（error_kind="target"）；
+限速/重试/落库语义与 src/notify/telegram.py 逐字一致。
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+
+from framework.delivery.router import Channel, DeliveryResult, TargetOutcome
+from framework.delivery.targets import DeliveryTarget
+from framework.models.message import RenderedMessage
+
+logger = logging.getLogger(__name__)
+
+
+class TelegramChannel:
+    name = "telegram"
+
+    def __init__(self, api, storage, auth, *, rate_limit_seconds: float = 0.4) -> None:
+        self._api = api
+        self._storage = storage
+        self._auth = auth
+        self._rate = rate_limit_seconds
+
+    def describe(self) -> str:
+        return f"telegram@{len(self._auth.chats())} chats"
+
+    async def deliver(
+        self, msg: RenderedMessage, targets: list[DeliveryTarget]
+    ) -> DeliveryResult:
+        reply_markup = {"inline_keyboard": list(msg.buttons)} if msg.buttons else None
+        keys = ",".join(msg.event_keys)
+        outcomes: list[TargetOutcome] = []
+        for t in targets:
+            chat_id = t.address
+            try:
+                await self._api.send_message(chat_id, msg.body, reply_markup)
+                await self._storage.record_notification(chat_id, msg.body, keys, "success")
+                outcomes.append(TargetOutcome(target=t, status="success"))
+            except Exception as exc:  # 单 chat 失败不影响其他
+                logger.error("推送给 %s 失败: %s", chat_id, exc)
+                await self._storage.record_notification(chat_id, msg.body, keys, "failed")
+                outcomes.append(TargetOutcome(target=t, status="failed", error=str(exc),
+                                              error_kind="target"))
+            await asyncio.sleep(self._rate)
+        return DeliveryResult(outcomes=tuple(outcomes))
diff --git a/tests/test_channels.py b/tests/test_channels.py
new file mode 100644
index 0000000..ff06402
--- /dev/null
+++ b/tests/test_channels.py
@@ -0,0 +1,98 @@
+"""framework/delivery 通道与路由单测（对应 T17/T18/T19）。"""
+
+from __future__ import annotations
+
+import asyncio
+
+import unittest.mock as mock
+
+import httpx
+import pytest
+
+from framework.delivery.router import ChannelRouter, ChannelFailure, DeliveryResult
+from framework.delivery.targets import telegram_chat, ntfy_topic
+from framework.delivery.telegram_channel import TelegramChannel
+from framework.delivery.ntfy_channel import NtfyChannel
+from framework.models.message import RenderedMessage
+
+
+async def fake_post(self, url, content, headers):
+    if "fail" in url:
+        raise httpx.ConnectError("gone")
+    class R:
+        def raise_for_status(self): pass
+    return R()
+
+
+class FakeStorage:
+    def __init__(self) -> None:
+        self.calls: list[tuple[str, str, str, str]] = []
+
+    async def record_notification(self, chat_id, text, keys, status):
+        self.calls.append((chat_id, text, keys, status))
+
+
+class FakeApi:
+    def __init__(self, fail: set[str] | None = None) -> None:
+        self.fail = fail or set()
+
+    async def send_message(self, chat_id, text, reply_markup):
+        if chat_id in self.fail:
+            raise RuntimeError("boom")
+
+
+class FakeAuth:
+    def __init__(self, chats: list[str]) -> None:
+        self._chats = chats
+
+    def chats(self):
+        return self._chats
+
+
+def test_telegram_describe_and_target_outcomes():
+    st = FakeStorage()
+    ch = TelegramChannel(FakeApi(fail={"2"}), st, FakeAuth(["1", "2"]))
+    assert ch.describe() == "telegram@2 chats"
+
+    msg = RenderedMessage(body="hi", event_keys=("trader",))
+    res = asyncio.run(ch.deliver(msg, [telegram_chat("1"), telegram_chat("2")]))
+
+    assert [o.status for o in res.outcomes] == ["success", "failed"]
+    assert res.outcomes[1].error_kind == "target"          # T19：target 级失败
+    assert [c[0] for c in st.calls] == ["1", "2"]
+    assert [c[3] for c in st.calls] == ["success", "failed"]  # telegram 双落痕
+
+
+def test_ntfy_success_only_records_then_router_channel_failure():
+    st = FakeStorage()
+    ch = NtfyChannel("https://ntfy.sh", storage=st)
+    assert ch.describe() == "ntfy@https://ntfy.sh"
+
+    msg = RenderedMessage(body="n", body_format="text", event_keys=("daily_report",))
+    with mock.patch.object(httpx.AsyncClient, "post", fake_post):
+        with pytest.raises(httpx.ConnectError):
+            asyncio.run(ch.deliver(msg, [ntfy_topic("ok"), ntfy_topic("fail")]))
+        assert st.calls == [("https://ntfy.sh/ok", "n", "daily_report", "success")]  # ntfy 只落成功，失败上抛
+
+
+class Prov:
+    def __init__(self, targets): self._t = targets
+    def targets(self): return self._t
+
+
+def test_router_catches_channel_exception_with_reference():
+    st = FakeStorage()
+    bad = NtfyChannel("https://ntfy.sh", storage=st)
+
+    async def boom(self, url, content, headers):
+        raise httpx.ConnectError("down")
+    with mock.patch.object(httpx.AsyncClient, "post", boom):
+        router = ChannelRouter([bad], Prov([ntfy_topic("x")]))
+        res = asyncio.run(router.dispatch("daily_report", RenderedMessage(body="x")))
+
+    assert res.configured_channels == 1                  # T18：与 targets 是否成功无关
+    assert len(res.channel_failures) == 1
+    f = res.channel_failures[0]
+    assert isinstance(f, ChannelFailure)
+    assert f.channel == "ntfy"
+    assert f.reference == "ntfy@https://ntfy.sh"         # T19：reference = describe()
