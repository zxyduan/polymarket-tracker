# market 交易员监控配置
# 配置说明：watchlist 支持配置多个交易员地址，推荐填写 market 个人主页/排行榜上的地址（代理钱包）。
# 运行后也可通过 Telegram 指令 /add、/remove 动态增删，动态名单存入 SQLite，本文件只做启动种子。

watchlist:
  - address: "0x0000000000000000000000000000000000000000"
    label: "示例交易员（请替换为真实地址）"

# 轮询与连接
polling:
  reconciliation_interval_seconds: 60    # L2 对账周期
  rtds_heartbeat_seconds: 15             # RTDS 心跳间隔
  reconnect_min_seconds: 1               # 重连退避下限
  reconnect_max_seconds: 30              # 重连退避上限
  request_timeout_seconds: 10
  max_concurrent_requests: 5
  cold_start_fetch_limit: 50

# 过滤与聚合
filters:
  min_notional_usd: 0                    # 仅推送不低于该金额（price × size）的成交
  event_types:                           # 推送的事件类型
    - TRADE
    # 可选：SPLIT、MERGE、REDEEM、CONVERT、REWARD
  aggregate_window_seconds: 3            # 同一笔结算多笔成交的聚合窗口

# 交易员告警批量摘要（攒批 + 大单提前触发；enabled=false 或不写本小节 = 逐笔即时推送）
digest:
  enabled: true
  scope: "global"          # global=全部监控地址合并成一条摘要；wallet=每个地址各一条
  window_seconds: 60       # 配置A：首条消息到达后最多攒 60s，到点把累计内容合成一条发出
  flush_shares: 2000       # 配置B：窗口内累计成交量(份额) ≥ 2000 立即发送；0=不启用该方向
  flush_usdc: 1000         # 配置B：窗口内累计成交额(USDC) ≥ 1000 立即发送；0=不启用该方向
  # 说明：两个阈值是「或」关系；阈值触发后清零重新累计，连续大单连续推送，不限制次数；
  #       无交易的窗口不发消息；min_notional_usd 以下的小额单不进摘要、不计数。

# 市场元数据缓存
market_cache:
  ttl_hours: 24

# 日志（大小轮转，防止日志占满磁盘）
logging:
  file: "logs/monitor.log"   # 留空则只输出 stdout
  max_mb: 10                 # 单文件上限
  backups: 5                 # 保留滚动份数（总占用 ≈ 60MB）

# 事件库保留时长
events:
  retention_days: 180
  notifications_retention_days: 30   # 推送记录保留时长

# 展示时区（时间 UTC+8）
display:
  timezone_offset_hours: 8

# 市场快照：采集与推送（市场列表在 config/markets.toml 配置）
snapshot_push:
  enabled: true                # 是否推送总览（false = 只采集落库）
  mode: "summary"              # summary=合并一条总览（当前实现）
  schedule:                    # 时间推送时刻（同一时刻重复配置会自动去重）
    - "06:00"
    - "09:00"
    - "12:00"
    - "15:00"
    - "18:00"
    - "20:00"
    - "24:00"
  timezone_offset_hours: 8     # 时间 UTC+8
  dedup: true                  # 正文与上一条完全一致则抑制（2h 桶配整点推送时，奇数点自动去重）
  max_stale_buckets: 0         # 最新桶落后超过 N 个桶则跳过推送（0=不跳过，仅在标题提示延迟）

snapshot:
  bucket_seconds: 7200         # 时间桶长度（2h，与参考源一致，勿改）
  collect_interval_seconds: 600  # 采集间隔（秒），默认 10 分钟；桶内重试 + 漏桶自愈依赖该间隔
  retention_days: 90           # 快照保留天数
  price_fidelity_minutes: 60   # 价格历史采样粒度（分钟）
  wall_min_notional: 100.0     # 订单簿"墙"阈值（USDC）
  request_timeout_seconds: 15

# 日报：当日成交份额汇总推送
daily_report:
  enabled: true
  schedule: "08:00"             # 每日推送时刻
  windows_days: [1, 7, 30]      # 窗口天数
  timezone_offset_hours: 8
  top_n: 10                     # Top N 市场
  page_size: 20
  dedup: true

# 每日市场筛选：采集轮每日定时拉取公开 Gamma 市场，按时间-概率档位落库；
# P1 只落库表/视图，不做展示页；只读二次筛选直接查库。
market_screen:
  enabled: true
  schedule: "08:00"              # 每日采集时刻（HH:MM，24h 制）
  timezone_offset_hours: 8
  retry_seconds: 5               # 命中分钟内失败重试间隔（秒）
  retention_days: 30              # 筛选候选保留天数

  volume:
    metric: "volume24hr"          # USDC 名义成交额口径（P1 仅此一种）
    min_value: 50000.0           # 24h 成交额下限（USDC）
    top_n: 200                   # 按 24h 量倒序截断的候选上限
    page_limit: 100              # Gamma 分页大小
    max_pages: 4                 # 最多翻页数（4×100=400 候选上限）
    request_timeout_seconds: 10  # 单页 HTTP 超时
    retry_attempts: 2            # 网络错误/429/5xx 透明重试次数；4xx（除 429）不重试
    retry_backoff_seconds: 1.0   # 指数退避基数秒数
    page_delay_seconds: 0.2      # 串行翻页间隔

  horizon_prob:
    enabled: true                # 概率×到期时间规则总开关；false=只做量阈值+TopN
    preset: "balanced"           # 主档 strict | balanced | loose（passed_count 按主档统计）
    record_all_presets: true      # 并行记录三档标志；false 仅主档计算，其余留 NULL
    mode: "anchor_linear"       # P1 仅 anchor_linear；formula 预留 P2
    # anchors: []                 # 非空单组列表整体覆盖主档模板；须 days 升序、minority_max∈(0,0.5)
    # anchors:
    #   - { days: 30, minority_max: 0.01 }
    #   - { days: 60, minority_max: 0.02 }
    #   - { days: 365, minority_max: 0.10 }
    clamp_min: 0.002
    clamp_max: 0.20

  binary_only: true              # 仅 Yes/No 二元市场
  persist_non_passed: true       # 未过主档候选也落库（持续性主场景依赖候选池历史）

  query_defaults:                 # 持续性只读查询默认参数（门面未显式传入时回落）
    window_days: 10
    min_hit_days: 10
    require_consecutive: false
    min_volume_24h: 50000.0
    max_rank: 200
    min_remaining_days: 31
    prob_max: 0.15               # 小侧概率上限（主场景 ≤15%）
    prob_side: "minority"        # minority | yes

  notify:
    enabled: false               # P1 不装配推送通道


# 服务端点（集中配置，接口变更只改这里）
endpoints:
  rtds: "wss://ws-live-data.polymarket.com"
  data_api: "https://data-api.polymarket.com"
  gamma_api: "https://gamma-api.polymarket.com"
  clob_api: "https://clob.polymarket.com"
  polygonscan: "https://polygonscan.com"

# 消息推送通道列表：可多平台同时启用（如 ntfy + telegram 一起推送）
#   telegram：需要 BOT_TOKEN / SNAPSHOT_BOT_TOKEN（.env），支持 /指令 交互
#   ntfy：无需 Bot token，订阅端 App 按 topic 收推送；单向推送（无指令交互）
# 后续扩展其他平台时在此列表上新增枚举即可（src/notify/factory.py）
notify:
  platforms: ["telegram"]     # ["telegram"] | ["ntfy"] | ["ntfy", "telegram"] …
  # 兼容旧写法（单平台）：platform: "ntfy"

# ntfy 通道配置（notify.platforms 含 ntfy 时生效；server 可自建）
ntfy:
  server: "https://ntfy.sh"      # 或自建 https://ntfy.example.com
  topic: "polymarket-alerts"     # 交易员告警 topic（订阅端 App 需订阅同名 topic）
  snapshot_topic: "polymarket-snap"  # 快照总览 topic（缺省则用 topic）
  access_token: ""               # 可选：私有 topic / 自建服务器鉴权（发布需 Bearer token）
  title_prefix: "market"     # 可选：推送标题前缀
  priority: ""                   # 可选：1-5（如 3=默认、4=高优先级）
  tags: ""                       # 可选：英文逗号分隔，如 "chart,robot"

# 可选：EOA → Gnosis Safe 代理钱包 CREATE2 派生常量
# 留空 proxy_init_code 时跳过链上派生；联调阶段用真实地址验证（见校验报告 TBD-03）
safe_proxy:
  factory: "0xaacFe3a05d134b1b169f736553b30dca3eedf04d"
  singleton: "0xfb1bffC9d739B8D520DaF37dF666da4C687191EA"
  proxy_init_code: ""

# P1 灰度开关
p1:
  trader_enabled: true   # 交易推送新路径开关，出问题设 false 回退旧路径

