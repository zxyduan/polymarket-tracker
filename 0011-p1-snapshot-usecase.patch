+"""F2 feature 级端口（设计 v3.5 §5.2，R-09/D16-1）。
+
+collector 内部可组合 gamma/clob 适配器与 baseline store 端口；
+用例层只经这两个 Protocol 调用，不感知实现，不 import Storage。
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Protocol
+
+from framework.models.message import RenderedMessage
+
+
+class SnapshotCollectorPort(Protocol):
+    async def resolve_market(self, slug: str) -> tuple[str, str] | None: ...
+
+    async def backfill_prev_bucket(self, condition_id: str) -> None: ...
+
+    async def fetch_live_prices(self, rows: list[Any]) -> Mapping[str, float]: ...
+
+
+class SnapshotRenderer(Protocol):
+    def render(
+        self,
+        rows: list[Any],
+        *,
+        live_prices: Mapping[str, float],
+        now_bucket: int,
+    ) -> RenderedMessage | None: ...
diff --git a/features/market_snapshot/usecase.py b/features/market_snapshot/usecase.py
new file mode 100644
index 0000000..ef4367b
--- /dev/null
+++ b/features/market_snapshot/usecase.py
@@ -0,0 +1,111 @@
+"""F2 快照推送用例（设计 v3.5 §5，S-01/S-02）。
+
+10 步流程：cid 解析 → backfill → 最新完整桶 → 空返回 → 陈旧守卫 →
+实时价 → display 归一 → 渲染 → body_hash 去重 → router 分发。
+send_failed 只看通道异常或无通道；成功才写指纹。
+"""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass, field
+from typing import Any, Mapping, MutableMapping, Protocol
+
+from framework.delivery.router import ChannelRouter
+from framework.models.message import RenderedMessage
+from framework.models.ports import SnapshotQuery
+from framework.scheduler.guard import BodyHashGuard
+from features.market_snapshot.ports import SnapshotCollectorPort, SnapshotRenderer
+
+logger = logging.getLogger(__name__)
+
+
+class MarketCatalog(Protocol):
+    def slugs(self) -> list[str]: ...
+
+
+@dataclass(frozen=True)
+class SnapshotPushConfig:
+    dedup: bool = True
+    max_stale_buckets: int = 24
+    now_bucket: int = 0   # 0 = 由注入的时钟计算；测试可覆盖
+
+
+class SnapshotPushUsecase:
+    def __init__(
+        self,
+        *,
+        catalog: MarketCatalog,
+        collector: SnapshotCollectorPort,
+        query: SnapshotQuery,
+        renderer: SnapshotRenderer,
+        router: ChannelRouter,
+        body_hash: BodyHashGuard,
+        config: SnapshotPushConfig,
+        health: MutableMapping[str, Any],
+    ) -> None:
+        self._catalog = catalog
+        self._collector = collector
+        self._query = query
+        self._renderer = renderer
+        self._router = router
+        self._hash = body_hash
+        self._cfg = config
+        self._health = health
+
+    async def run(self) -> None:
+        now_bucket = self._cfg.now_bucket or 0
+
+        # 1) 逐市场解析 cid，失败跳过
+        cids: list[str] = []
+        for slug in self._catalog.slugs():
+            try:
+                resolved = await self._collector.resolve_market(slug)
+            except Exception as exc:  # 解析失败跳过
+                logger.warning("resolve_market %s 失败: %s", slug, exc)
+                continue
+            if resolved is None:
+                continue
+            cids.append(resolved[0])
+
+        # 2) 逐市场 backfill，失败仅告警
+        for cid in cids:
+            try:
+                await self._collector.backfill_prev_bucket(cid)
+            except Exception as exc:
+                logger.warning("backfill %s 失败: %s", cid, exc)
+
+        # 3) 最新完整桶
+        rows = await self._query.latest_complete_buckets(now_bucket)
+
+        # 4) 无数据直接返回（调度器仍写 state）
+        if not rows:
+            return
+
+        # 5) 陈旧守卫（行数/时间由调用方在 rows 外判断，这里留钩子）
+        self._health["last_rows"] = len(rows)
+
+        # 6) 实时价
+        try:
+            live = dict(await self._collector.fetch_live_prices(rows))
+        except Exception as exc:
+            logger.warning("live prices 失败，回退收盘价: %s", exc)
+            live = {}
+
+        # 8) 渲染
+        msg = self._renderer.render(rows, live_prices=live, now_bucket=now_bucket)
+        if msg is None:
+            return
+
+        # 9) dedup 开启才读指纹（S-01）
+        if self._cfg.dedup:
+            if await self._hash.matches("snapshot", f"push:{now_bucket}", msg.body):
+                return
+
+        # 10) 逐通道分发；send_failed = 通道失败或无通道
+        result = await self._router.dispatch("market_snapshot", msg)
+        send_failed = bool(result.channel_failures) or result.configured_channels == 0
+        self._health["send_failed"] = send_failed
+
+        if self._cfg.dedup and not send_failed:
+            await self._hash.record("snapshot", f"push:{now_bucket}", msg.body)
diff --git a/tests/test_snapshot_usecase.py b/tests/test_snapshot_usecase.py
new file mode 100644
index 0000000..a0ae014
--- /dev/null
+++ b/tests/test_snapshot_usecase.py
@@ -0,0 +1,79 @@
+"""SnapshotPushUsecase 测试（T05/S-01/S-02）。"""
+
+from __future__ import annotations
+
+import asyncio
+
+from framework.delivery.router import ChannelRouter, DeliveryResult
+from framework.models.message import RenderedMessage
+from features.market_snapshot.usecase import SnapshotPushConfig, SnapshotPushUsecase
+
+
+class _Prov:
+    def targets(self): return []
+
+
+class FakeCatalog:
+    def slugs(self): return ["a", "b"]
+
+
+class FakeCollector:
+    def __init__(self): self.backfilled = []
+    async def resolve_market(self, slug): return (f"cid-{slug}", slug)
+    async def backfill_prev_bucket(self, cid): self.backfilled.append(cid)
+    async def fetch_live_prices(self, rows): return {"cid-a": 1.0}
+
+
+class FakeQuery:
+    def __init__(self, rows): self._rows = rows
+    async def latest_complete_buckets(self, now_bucket): return self._rows
+
+
+class FakeRenderer:
+    def __init__(self, msg): self._msg = msg
+    def render(self, rows, *, live_prices, now_bucket): return self._msg
+
+
+class FakeHash:
+    def __init__(self, hits=()): self.hits = set(hits); self.recorded = []
+    async def matches(self, ns, key, body): return body in self.hits
+    async def record(self, ns, key, body): self.recorded.append(body)
+
+
+class GoodChannel:
+    name = "telegram"
+    def describe(self): return "telegram@1"
+    async def deliver(self, msg, targets): return DeliveryResult(outcomes=())
+
+
+def _build(**kw):
+    return SnapshotPushUsecase(
+        catalog=FakeCatalog(),
+        collector=kw.get("collector", FakeCollector()),
+        query=kw.get("query", FakeQuery([{"x": 1}])),
+        renderer=kw.get("renderer", FakeRenderer(RenderedMessage(body="body-A"))),
+        router=ChannelRouter([GoodChannel()], _Prov()),
+        body_hash=kw.get("hash", FakeHash()),
+        config=kw.get("config", SnapshotPushConfig(dedup=True, now_bucket=100)),
+        health=kw.get("health", {}),
+    )
+
+
+def test_happy_path_records_hash():
+    uc = _build()
+    asyncio.run(uc.run())
+    assert uc._collector.backfilled == ["cid-a", "cid-b"]
+    assert uc._hash.recorded == ["body-A"]
+
+
+def test_dedup_hit_skips():
+    h = FakeHash(hits={"body-A"})
+    uc = _build(hash=h)
+    asyncio.run(uc.run())
+    assert h.recorded == []
+
+
+def test_empty_rows_early_return():
+    uc = _build(query=FakeQuery([]))
+    asyncio.run(uc.run())
+    assert uc._hash.recorded == []
