diff --git a/features/daily_report/renderer.py b/features/daily_report/renderer.py
new file mode 100644
index 0000000..1b2f2ad
--- /dev/null
+++ b/features/daily_report/renderer.py
@@ -0,0 +1,25 @@
+"""F3 日报渲染适配层（§7）。"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from framework.models.message import RenderedMessage
+
+
+class LegacyDailyRenderer:
+    def render(self, rows: list[Any], *, windows_days: list[int],
+               now_bucket: int, tz_offset_hours: int,
+               top_n: int) -> RenderedMessage | None:
+        from src.main import render_daily_volume_report
+
+        rep = render_daily_volume_report(
+            rows, windows_days=windows_days, now_bucket=now_bucket,
+            tz_offset_hours=tz_offset_hours, top_n=top_n,
+        )
+        if rep is None:
+            return None
+        body = rep.title + "\n" + "\n".join(rep.market_lines)
+        if rep.footer:
+            body += "\n" + rep.footer
+        return RenderedMessage(body=body)
diff --git a/features/market_snapshot/renderer.py b/features/market_snapshot/renderer.py
new file mode 100644
index 0000000..c45d9c1
--- /dev/null
+++ b/features/market_snapshot/renderer.py
@@ -0,0 +1,36 @@
+"""F2 快照渲染适配层（§5.2）。
+
+把旧 render_snapshot_summary 包成 SnapshotRenderer 协议；
+live_prices 注入与 shares_display 归一在这里完成。
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from framework.models.message import RenderedMessage
+
+
+class LegacySnapshotRenderer:
+    def __init__(self, *, tz_offset_hours: int = 8,
+                 bucket_seconds: int = 7200) -> None:
+        self._tz = tz_offset_hours
+        self._bs = bucket_seconds
+
+    def render(self, rows: list[Any], *, live_prices: Mapping[str, float],
+               now_bucket: int) -> RenderedMessage | None:
+        from src.snapshots.renderer import render_snapshot_summary
+
+        for r in rows:
+            cid = str(r.get("condition_id") or "")
+            if cid in live_prices:
+                r["current_price"] = live_prices[cid]
+            sh = r.get("volume_shares")
+            r["volume_shares_display"] = float(sh) if sh is not None else -1.0
+        alert = render_snapshot_summary(
+            rows, tz_offset_hours=self._tz,
+            bucket_seconds=self._bs, now_bucket=now_bucket,
+        )
+        if alert is None:
+            return None
+        return RenderedMessage(body=alert.html)
