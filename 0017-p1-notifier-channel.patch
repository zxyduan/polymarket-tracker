From: zxyduan <944781538@qq.com>
Date: Tue, 3 Nov 2026 12:43:01 +0800
Subject: [PATCH] feat(p1): NotifierChannel adapter for router cutover

---
 framework/adapters/notifier_channel.py | 28 ++++++++++++++++++++++++++
 tests/test_notifier_channel.py         | 28 ++++++++++++++++++++++++++
 2 files changed, 56 insertions(+)
 create mode 100644 framework/adapters/notifier_channel.py
 create mode 100644 tests/test_notifier_channel.py

diff --git a/framework/adapters/notifier_channel.py b/framework/adapters/notifier_channel.py
new file mode 100644
index 0000000..caa8c8e
--- /dev/null
+++ b/framework/adapters/notifier_channel.py
@@ -0,0 +1,28 @@
+"""把现有 Notifier 适配成 framework Channel（双轨切换用）。"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from framework.delivery.router import ChannelFailure, DeliveryResult
+from framework.models.message import RenderedMessage
+
+
+class NotifierChannel:
+    name = "legacy_notifier"
+
+    def __init__(self, notifier: Any) -> None:
+        self._n = notifier
+
+    def describe(self) -> str:
+        return getattr(self._n, "describe", lambda: "legacy")()
+
+    async def deliver(self, msg: RenderedMessage, targets: list) -> DeliveryResult:
+        try:
+            await self._n.send(msg.body)
+            return DeliveryResult(outcomes=())
+        except Exception as exc:  # noqa: BLE001
+            return DeliveryResult(
+                outcomes=(),
+                channel_failures=[ChannelFailure(self.name, exc, self.describe())],
+            )
diff --git a/tests/test_notifier_channel.py b/tests/test_notifier_channel.py
new file mode 100644
index 0000000..2ff6071
--- /dev/null
+++ b/tests/test_notifier_channel.py
@@ -0,0 +1,28 @@
+"""NotifierChannel 适配测试。"""
+
+import asyncio
+
+from framework.adapters.notifier_channel import NotifierChannel
+from framework.models.message import RenderedMessage
+
+
+class Good:
+    async def send(self, body): self.body = body
+    def describe(self): return "tg"
+
+
+class Bad:
+    async def send(self, body): raise RuntimeError("boom")
+    def describe(self): return "ntfy"
+
+
+def test_good_deliver():
+    c = NotifierChannel(Good())
+    res = asyncio.run(c.deliver(RenderedMessage(body="x"), []))
+    assert not res.channel_failures
+
+
+def test_bad_captured():
+    c = NotifierChannel(Bad())
+    res = asyncio.run(c.deliver(RenderedMessage(body="x"), []))
+    assert len(res.channel_failures) == 1
-- 
