---
 framework/models/ports.py         | 20 +++++++++++++++++++-
 framework/store/snapshot_store.py |  4 ++++
 tests/test_snapshot_store.py      |  6 ++++++
 3 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/framework/models/ports.py b/framework/models/ports.py
index 91fc966..0cd9472 100644
--- a/framework/models/ports.py
+++ b/framework/models/ports.py
@@ -6,7 +6,10 @@
 
 from __future__ import annotations
 
-from typing import Protocol, runtime_checkable
+from typing import TYPE_CHECKING, Protocol, runtime_checkable
+
+if TYPE_CHECKING:
+    from framework.models.snapshot import WindowSum
 
 
 @runtime_checkable
@@ -16,3 +19,18 @@ class CursorStore(Protocol):
     async def get(self, namespace: str, key: str) -> str | None: ...
 
     async def set(self, namespace: str, key: str, value: str) -> None: ...
+
+
+@runtime_checkable
+class SnapshotQuery(Protocol):
+    """F2/F3 用例依赖的快照查询端口（§3.2）。
+
+    latest_complete_buckets 暂时仍返回 dict 行（Snapshot 26 字段 DTO
+    待 P5 落地）；windows_sum 已返回 WindowSum DTO。
+    """
+
+    async def latest_complete_buckets(self, now_bucket: int) -> list[dict]: ...
+
+    async def windows_sum(
+        self, *, start_ts: int, end_ts: int, cid: str | None = None
+    ) -> list["WindowSum"]: ...
diff --git a/framework/store/snapshot_store.py b/framework/store/snapshot_store.py
index 5859cee..b118ba6 100644
--- a/framework/store/snapshot_store.py
+++ b/framework/store/snapshot_store.py
@@ -18,6 +18,10 @@ class SnapshotStore:
     def __init__(self, storage: "Storage") -> None:
         self._storage = storage
 
+    async def latest_complete_buckets(self, now_bucket: int) -> list[dict]:
+        """逐字平移 storage.latest_complete_buckets。"""
+        return await self._storage.latest_complete_buckets(now_bucket)
+
     async def windows_sum(
         self, *, start_ts: int, end_ts: int, cid: str | None = None
     ) -> list[WindowSum]:
diff --git a/tests/test_snapshot_store.py b/tests/test_snapshot_store.py
index eb88eeb..b549b8b 100644
--- a/tests/test_snapshot_store.py
+++ b/tests/test_snapshot_store.py
@@ -46,3 +46,9 @@ async def test_windows_sum_basic_and_cid_filter(storage):
     # 开闭区间边界：end_ts 上界不包含
     empty = await s.windows_sum(start_ts=B, end_ts=B)
     assert empty == []
+
+
+def test_snapshot_store_satisfies_query_protocol(storage):
+    from framework.models.ports import SnapshotQuery
+    from framework.store.snapshot_store import SnapshotStore
+    assert isinstance(SnapshotStore(storage), SnapshotQuery)
