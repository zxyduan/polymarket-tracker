# Telegram Bot 配置（找 @BotFather 创建 Bot 获取 token）
# 交易员监控 Bot（实时交易推送）
BOT_TOKEN=

# 市场快照 Bot（独立新建，推送每 2h 快照总览；缺省则快照只采集不推送）
SNAPSHOT_BOT_TOKEN=

# 授权 chat 白名单，多个用英文逗号分隔，如：123456789,987654321
# 留空时，首个向 Bot 发送 /start 的用户将自动成为管理员（写入 SQLite）
# 两个 Bot 白名单相互独立：交易员 Bot 用本项，快照 Bot 首个 /start 用户自动管理员
ALLOWED_CHAT_IDS=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
